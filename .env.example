# Configuration the gateway reads, all via SOUK_* environment variables
# (pydantic-settings). NOTE: nothing auto-loads this file — it documents
# what to `export` (or set in docker-compose / your process manager).
#
# Core (souk — see AgentSouk/souk/souk/config.py)
# Unset SOUK_DATABASE_URL = zero-config SQLite at ./souk.db.
#SOUK_DATABASE_URL=postgresql+psycopg://souk:souk@localhost:5433/souk
#SOUK_DB_SCHEMA=public
# Required for any real deployment — signs session tokens and KYOK HMACs.
#SOUK_TOKEN_SIGNING_SECRET=change-me
# This souk's own Ed25519 identity (hex, 64 chars — a 32-byte seed), and
# what a provider pins so it can tell this souk from anything else
# answering the same URL. Generate one with:
#
#   uv run python -c "from souk.identity import SoukIdentity; print(SoukIdentity.generate_hex())"
#
# Unset means souk cannot prove itself, which is what every souk did
# before this existed: providers still connect, they just learn nothing
# about who answered. A provider that pinned a key refuses such a souk.
# Every replica of one souk must carry the same value, or a provider sees
# a different identity depending on which replica it reaches.
#SOUK_IDENTITY_PRIVATE_KEY=

# Serving (souk_server — see souk_server/config.py). One listener carries
# everything, WebSocket relays included (docs/server-mode.md).
#SOUK_HTTP_HOST=0.0.0.0
#SOUK_HTTP_PORT=8000
# URL advertised in A2A Agent Cards — what callers reach this souk at.
#SOUK_PUBLIC_HTTP_URL=http://localhost:8000
#SOUK_CORS_ALLOW_ORIGINS=["*"]
# TLS; dev pair: uv run python AgentSouk/scripts/gen_dev_tls_cert.py
#SOUK_HTTP_TLS_CERT_PATH=
#SOUK_HTTP_TLS_KEY_PATH=
