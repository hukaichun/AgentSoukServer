.venv/
__pycache__/
*.pyc
.env

# Local SQLite database files — souk's zero-config default backend writes
# ./souk.db (plus -wal/-shm sidecars) when SOUK_DATABASE_URL is unset. Local
# state, never commit; a real deployment uses Postgres instead.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Provider identity keys — a credential, never commit one.
*.key
souk_identity.key

# Dev-only TLS cert/key generated by AgentSouk/scripts/gen_dev_tls_cert.py.
dev_cert.pem
dev_key.pem

# Generated by AgentSouk/scripts/gen_proto.sh — regenerate, don't commit.
# grpc_gen/__init__.py IS committed; these patterns deliberately miss it.
souk_server/grpc_gen/*_pb2.py
souk_server/grpc_gen/*_pb2.pyi
souk_server/grpc_gen/*_pb2_grpc.py

.pytest_cache/
